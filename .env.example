# ============================================================
# ABASTIX — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raiz del monorepo:
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (PowerShell / Windows CMD)
# 2. Modifica las credenciales y genera un secreto JWT unico.
# 3. NUNCA subas el archivo .env real al control de versiones Git.
# ============================================================

# ------------------------------------------------------------
# 1. PUERTOS EXPUESTOS AL HOST (LOCAL)
# ------------------------------------------------------------
FRONTEND_PORT=5173
SERVER_PORT=8088
SQL_PORT=1433
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------
# 2. CONFIGURACION PARA DOCKER COMPOSE (MODO RECOMENDADO)
# ------------------------------------------------------------
# En Docker Compose, los servicios se comunican usando sus nombres
# en la red interna ('sqlserver' y 'rabbitmq').
# La URL JDBC interna se define automaticamente en compose.yaml:
#   jdbc:sqlserver://sqlserver:1433;databaseName=AbastixDB;encrypt=true;trustServerCertificate=true;

# Credenciales de Microsoft SQL Server 2022
# La contrasena SA debe cumplir politicas de complejidad de MSSQL (min 8 car., mayusculas, minusculas, numeros y simbolos).
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=AbastixPassword2026!

# Credenciales dedicadas de RabbitMQ (NO usar 'guest' en Docker)
SPRING_RABBITMQ_USERNAME=abastix
SPRING_RABBITMQ_PASSWORD=AbastixRabbit2026!

# Seguridad JWT (HS256: minimo 32 caracteres / 256 bits)
# Generar clave segura: openssl rand -base64 32
JWT_SECRET=AbastixEnterpriseSecureSecretKey2026ParaFirmaJWTDeAccesoYRefresco
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cookies y CORS
# En desarrollo local HTTP: false y Lax
# En produccion HTTPS con dominios cruzados: true y None
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://abastix.vercel.app

# ------------------------------------------------------------
# 3. MODO ALTERNATIVO: DESARROLLO LOCAL SIN DOCKER (pnpm dev)
# ------------------------------------------------------------
# Si ejecutas el backend directamente en tu maquina host sin Docker:
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=AbastixDB;encrypt=true;trustServerCertificate=true;
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=AbastixPassword2026!
# SPRING_RABBITMQ_HOST=localhost
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=abastix
# SPRING_RABBITMQ_PASSWORD=AbastixRabbit2026!
# VITE_API_BASE_URL=http://localhost:8088

# ------------------------------------------------------------
# 4. PRODUCCION (FRONTEND EN VERCEL)
# ------------------------------------------------------------
# En el panel de Vercel solo debe configurarse:
# VITE_API_BASE_URL=https://tu-backend-publico.com
# (NUNCA introducir credenciales de base de datos, contrasenas SA ni JWT_SECRET en Vercel)
