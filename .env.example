# ============================================================
# ABASTIX — VARIABLES DE ENTORNO
# Copia este archivo como .env en la raiz y/o frontend/.env
# ============================================================

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8088

# Backend (Spring Boot)
SERVER_PORT=8088

# Base de datos Microsoft SQL Server
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=AbastixDB;encrypt=true;trustServerCertificate=true;
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=YourStrongPassword!

# Seguridad JWT (minimo 32 caracteres para HS256)
JWT_SECRET=AbastixEnterpriseSecureSecretKey2026ParaFirmaJWTDeAccesoYRefresco
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
